{
  "name": "xiaojueshi-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:core": "node --experimental-strip-types --test tests/core.test.mjs tests/storage-core.test.mjs",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare NUXT_BUILD_DIR=.nuxt-cloudflare nuxt build",
    "preview:cloudflare": "wrangler dev --config wrangler.jsonc",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy --config wrangler.jsonc",
    "test:cloudflare": "node scripts/test-cloudflare.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "^6.36.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "codemirror": "^6.0.2",
    "katex": "^0.16.22",
    "lucide-vue-next": "^0.468.0",
    "mermaid": "^11.0.0",
    "nuxt": "^4.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@10.33.0"
}
